# UNFALLX – Konfiguration des Anfrageformulars
# Diese Werte in Hostinger (hPanel > Node.js-App > Umgebungsvariablen) setzen.
# Niemals echte Zugangsdaten in das Repository schreiben.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@unfallx.com
SMTP_PASS=
MAIL_FROM=info@unfallx.com
ANFRAGE_LIMIT=8


# UNFALLX Connect: private MySQL database, retained across deployments
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
PORTAL_ORIGIN=https://app.unfallx.com
PORTAL_ADMIN_EMAIL=info@unfallx.com
PORTAL_STORAGE_MB=2048
# Originaldateien: database bleibt aktiv, bis S3 eingerichtet und geprüft ist.
# Bei Umstellung auf s3 die folgenden fünf Werte vollständig hinterlegen.
PORTAL_FILE_STORAGE=database
PORTAL_S3_BUCKET=
PORTAL_S3_REGION=
PORTAL_S3_ACCOUNT_ID=
PORTAL_S3_ACCESS_KEY_ID=
PORTAL_S3_SECRET_ACCESS_KEY=
# Für S3 ausschließlich Frankfurt: PORTAL_S3_REGION=eu-central-1
# Startvorschlag: PORTAL_STORAGE_MB=102400 (100 GiB Upload-Limit, keine AWS-Kostengrenze).
# S3-Zugang ausschließlich in Hostinger, niemals im Browsercode oder Repository.
# Enable only behind the trusted Hostinger reverse proxy.
PORTAL_TRUST_PROXY=false

# Optionale Anbieter-Anmeldung. Leer = im Login nicht angeboten.
# Google OAuth-Clienttyp: Webanwendung; BEIDE Rücksprungadressen exakt:
# https://app.unfallx.com/api/portal/oauth/google/callback
# https://admin.unfallx.com/api/portal/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID + zugehörige Primary App ID mit Sign in with Apple.
# Optional, aktuell nicht aktiviert. Nur für tatsächlich angebotene Bereiche:
# https://app.unfallx.com/api/portal/oauth/apple/callback
# https://admin.unfallx.com/api/portal/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Privater .p8-Schlüssel, PEM; echte Zeilenumbrüche oder literale \n möglich.
APPLE_PRIVATE_KEY=

# Optionale SMS-Verifizierung + SMS-Zwei-Faktor-Anmeldung. Leer = kein Versand.
# Konto/AV-Vertrag und Guthaben bei seven.io zuerst einrichten.
SMS_PROVIDER=
SEVEN_API_KEY=
# Mindestens 32 zufällige Zeichen, unabhängig vom API-Key, nur in Hostinger.
PORTAL_OTP_SECRET=
# Harte Versandobergrenzen (Versuche inkl. unbestätigter Zustellung).
SMS_DAILY_LIMIT=100
SMS_MONTHLY_LIMIT=1000

# Optional: internal case transfer to autoiXpert (keep the real key in Hostinger only).
# Requires explicit per-case confirmation in the internal dashboard.
AUTOIXPERT_API_KEY=
AUTOIXPERT_ASSESSOR_ID=
